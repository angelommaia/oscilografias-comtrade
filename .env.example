# Copie para .env local ou configure no painel do Railway

# production | development
ENV=production

# Origens permitidas para CORS (separadas por vírgula)
# Em produção, deixe vazio se frontend e API estiverem no mesmo domínio
ALLOWED_ORIGINS=https://seu-app.up.railway.app

# Hosts confiáveis (opcional; * aceita o host do Railway)
ALLOWED_HOSTS=*

# Diretório com exemplos .cfg/.dat (padrão: ./samples)
COMTRADE_SAMPLES_DIR=/app/samples

# Produção: 50 MB. Sem esta variável, o padrão local é 2 GB.
MAX_UPLOAD_BYTES=52428800

# Railway define PORT automaticamente
PORT=8000
