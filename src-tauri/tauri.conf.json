{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oscilo",
  "version": "0.6.2",
  "identifier": "io.github.angelommaia.oscilo",
  "build": {
    "frontendDist": "../desktop/splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Oscilo – Oscilografias COMTRADE",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "category": "Utility",
    "shortDescription": "Análise de oscilografias COMTRADE",
    "longDescription": "Visualização e análise de oscilografias COMTRADE (IEEE C37.111): fasores, impedância, harmônicos e simulação de funções de proteção (21, 78, 87T, 50/51/67).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/server/": "server/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
